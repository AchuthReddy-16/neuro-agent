*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
dist/
build/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# =============================================================================
# Virtual environments
# =============================================================================
.venv/
.venv-*/
venv/
env/
.envrc

# =============================================================================
# IDE / editor scratch (do not commit)
# =============================================================================
.idea/
.vscode/
.cursor/
*.code-workspace
*.swp
*.swo
*~
.agent/
agent-scratch/
scratch/
tmp/
temp/
*.tmp
*.bak
*.agent.json
.cursorrules.local

# =============================================================================
# Secrets / local env
# =============================================================================
.env
.env.*
!.env.example
!**/.env.example
*.pem
credentials.json
secrets.yaml
secrets.json

# =============================================================================
# Jupyter
# =============================================================================
.ipynb_checkpoints/

# =============================================================================
# Checkpoints & model weights (never commit)
# =============================================================================
checkpoints/**
!checkpoints/.gitkeep
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.onnx

# =============================================================================
# Hugging Face / model caches
# =============================================================================
.cache/
.huggingface/
models/
hub/

# =============================================================================
# EEG / PhysioNet dataset
# Keep small reproducibility files only (manifests, metadata JSON, scripts).
# =============================================================================
data/**
!data/manifests/
!data/manifests/**
!data/metadata/
!data/metadata/**/
!data/metadata/**/*.json
!data/scripts/
!data/scripts/**

data/raw/
data/interim/
data/downloads/
data/processed/
data/processed/arrays/
data/processed/baseline/

# Large neuroscience file formats (anywhere)
datasets/
*.parquet
*.arrow
*.feather
*.npz
*.npy
*.h5
*.hdf5
*.nii
*.nii.gz
*.edf
*.edf.event
*.fif
*.jsonl

# =============================================================================
# Results: commit small JSON/MD/CSV summaries; exclude bulky traces & polls
# =============================================================================
results/**
!results/.gitkeep
!results/**/
!results/**/*.json
!results/**/*.md
!results/**/*.csv

# Re-ignore bulky / local-only result artifacts
results/api_experiments/
results/profiling/int8/
results/**/gpu_poll.csv
results/**/*_trace.json
results/**/per_request_traces.jsonl

# Profiler binary / oversized outputs
*_trace.json
*.nsys-rep
*.qdrep
*.ncu-rep
*.sqlite
*.prof
nsys-report.*
ncu-report.*

# Benchmarks: keep summaries; ignore temp runs
benchmarks/**/tmp/
benchmarks/**/*.tmp

# =============================================================================
# Logs & experiment trackers
# =============================================================================
*.log
logs/
wandb/
tensorboard/
mlruns/
lightning_logs/

# =============================================================================
# OS
# =============================================================================
.DS_Store
Thumbs.db
desktop.ini

# =============================================================================
# Nested accidental copies
# =============================================================================
neuro-agent/
