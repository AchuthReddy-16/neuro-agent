# =============================================================================
# Results & benchmarks
# Commit: small JSON/CSV summaries only
# Do NOT commit: huge traces, raw profiler outputs, temp logs
# =============================================================================
results/**
!results/.gitkeep
!results/hardware_verify.json
!results/profiling/
results/profiling/**
!results/profiling/gpu_profiling_validation_summary.json
!results/profiling/vram_investigation.json
!results/profiling/ncu/
results/profiling/ncu/**
!results/profiling/ncu/ncu_summary.json
!results/profiling/pytorch/
