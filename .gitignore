!results/profiling/pytorch/prefill_summary.json
!results/profiling/pytorch/decode_summary.json
!results/profiling/pytorch/profiling_summary.json

# Large / temporary profiler outputs (never commit)
*_trace.json
*.nsys-rep
*.qdrep
*.ncu-rep
*.sqlite
*.prof
nsys-report.*
ncu-report.*

# Benchmarks: JSON/CSV summaries are OK; ignore temp runs
benchmarks/**/tmp/
benchmarks/**/*.tmp

