# Local development (Next rewrites /api → this origin at build/dev time)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8080

# ---------------------------------------------------------------------------
# Vercel production / preview — REQUIRED
# Set in the Vercel project Environment Variables (Production + Preview).
# Must be the *public* GPU FastAPI origin (scheme + host[:port], no trailing slash).
# Do NOT leave unset in production (app will not silently fall back to localhost).
#
# Example (replace with your real public API origin from RunPod HTTP proxy / custom domain):
#   NEXT_PUBLIC_API_BASE_URL=https://YOUR_PUBLIC_GPU_API_ORIGIN
#
# Rebuild / redeploy after changing (Next.js rewrites resolve at build time).
# ---------------------------------------------------------------------------
